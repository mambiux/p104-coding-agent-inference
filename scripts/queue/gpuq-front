#!/usr/bin/env python3
# gpuq-front <name-substring>...  — move matching pending jobs to the front of the queue, in the order given (others keep their order)
import os,sys,time
Q='/home/mbx/longshot/tune/queue/pending'; files=sorted(os.listdir(Q)); picked=[]
for pat in sys.argv[1:]:
    for f in files:
        if pat in f.split('-',1)[1] and f not in picked: picked.append(f)
rest=[f for f in files if f not in picked]; base=int(time.time()*1e9)-3*10**12
for i,f in enumerate(picked+rest): os.rename(os.path.join(Q,f),os.path.join(Q,f"{base+i*1000}-{f.split('-',1)[1]}"))
print("front:", " ".join(f.split('-',1)[1].replace('.job','') for f in (picked+rest)[:12]))
