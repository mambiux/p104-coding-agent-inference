[Unit]
Description=Qwen3.5-9B Q5_K_M coding server on the P104 (upstream llama.cpp, 64k ctx) — conflicts with bonsai-best
After=network.target p104-power-cap.service
Conflicts=bonsai-best.service
[Service]
User=<user>
ExecStart=/home/<user>/longshot/qwen9b-serve.sh
Restart=on-failure
RestartSec=10
[Install]
WantedBy=multi-user.target
