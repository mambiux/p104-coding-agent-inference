+            uint32_t hi = __byte_perm(w[i][g], 0, 0x4342); // bytes 2, 3
+            uint32_t Pp = 0;                               // P_0 = 0
+#pragma unroll
+            for (int t = 0; t < 5; ++t) {
+                lo = ptq1_0_mul3(lo); // x 3^(t+1)
+                hi = ptq1_0_mul3(hi);
+                const uint32_t Pn = __byte_perm(lo, hi, 0x7531); // P_{t+1} of the four bytes
+                // qs[0..15]: element 16 t + 4 g + b; qs[16..23]: element 80 + 8 t + 4 (g - 4) + b
+                const int e = g < 4 ? 16*t + 4*g : 80 + 8*t + 4*(g - 4);
