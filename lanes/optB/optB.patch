+static __device__ __forceinline__ uint32_t ptq1_0_mul3(const uint32_t x) {
+    uint32_t r;
+    asm("shl.b32 %0, %1, 1;\n\tadd.u32 %0, %0, %1;" : "=r"(r) : "r"(x));
+    return r;
+}
