+    int A[ROWS][4];
+    int B[ROWS][4];
+#pragma unroll
+    for (int i = 0; i < ROWS; ++i) {
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            A[i][k] = 0;
+            B[i][k] = 0;
+        }
+    }
+#pragma unroll
+    for (int g = 0; g < 6; ++g) {
+#pragma unroll
+        for (int i = 0; i < ROWS; ++i) {
