+bool ggml_cuda_gdn_tail_fwht_q8_supported(const int S, const int blk, const int64_t ne00) {
+    return (S == 64 || S == 128) && (blk == 512 || blk == 1024 || blk == 2048) && blk % S == 0 && ne00 % blk == 0 &&
+           blk / S * 32 <= 1024;
+}
+
+// true when the unfused RMS_NORM + MUL would take the float4 path this kernel reproduces (rms_norm_f32_dispatch's vec test)
+bool ggml_cuda_gdn_tail_rms_vec_path(const ggml_tensor * rms_norm, const ggml_tensor * weight) {
+    const int ncols = (int) rms_norm->ne[0];
+    bool vec = rms_norm_vector_enabled() && ncols % 4 == 0 && ncols > 0 && ((uintptr_t) rms_norm->data & 15) == 0;
+    vec = vec && ggml_cuda_is_aligned(rms_norm->src[0], 16);
+    vec = vec && weight->ne[0] == ncols && ggml_cuda_is_aligned(weight, 16);
+    return vec && ncols / 4 <= 32;
+}
