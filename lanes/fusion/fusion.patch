+// head, lane l holding float4 l of the head: the same float4 path, rounding and reduction order as
+// rms_norm_f32<32, 1, true, true> with the multiply, then op_silu(z) * normed as unary_gated_op_kernel, then the
+// same scale/sign/butterfly/quantize as fwht_quantize_q8_1<N, NT, SOA_ISUM>, so the q8_1 bytes are identical.
+// Blocks beyond ne00 (the GGML_CUDA_PTQ1_K_PAD padding) write zero blocks like the plain quantizer.
+// nk, rep: the head regrouping between the GLU and the transform (RESHAPE [S, nk, rep] -> PERMUTE(0,2,1,3) -> CONT):
+// output head h = r + rep*k reads input head k + nk*r; rep == 1 is the identity.
+template <int N, int NT, int S>
+static __global__ void __launch_bounds__(NT) gdn_tail_fwht_q8_f32(
+        const float * x, const float * z, const float * weight, const float * signs, void * vy,
+        const int ne00, const int ne0, const float eps, const float fwht_scale, const int nk, const int rep) {
