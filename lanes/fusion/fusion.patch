+    } else {
+#pragma unroll
+        for (int i = 0; i < NE; ++i) {
+            reg[i] = 0.0f;
+        }
+    }
+
+    int32_t *     yw       = (int32_t *) vy;
+    const int64_t col_base = (int64_t) row * (ne0 / QK8_1) * (int64_t) (sizeof(block_q8_1) / 4);
+    const int     iqs      = lane % QK8_1;
+#pragma unroll
+    for (int i = 0; i < NE; ++i) {
+        const float xi = reg[i];
+        const int   i0 = base + i * NT + tid;
+        float amax = fabsf(xi);
+        amax = warp_reduce_max<QK8_1>(amax);
