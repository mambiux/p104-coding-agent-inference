+struct ggml_cuda_optime_unit { int i; cudaEvent_t ev; };
+struct ggml_cuda_optime_acc { double ms = 0; long n = 0; };
+struct ggml_cuda_optime {
+    int level = -1;
+    std::vector<ggml_cuda_optime_unit> units;
+    std::vector<cudaEvent_t> pool;
+    std::map<std::string, ggml_cuda_optime_acc> acc;
+    long n_graphs = 0;
+    bool dumped = false;
+    double total_ms = 0;
+    int lvl() {
+        if (level < 0) { const char * e = getenv("GGML_CUDA_OP_TIMING"); level = e ? atoi(e) : 0; }
+        return level;
+    }
+    cudaEvent_t get_event() {
+        if (pool.empty()) { cudaEvent_t e; CUDA_CHECK(cudaEventCreate(&e)); return e; }
+        cudaEvent_t e = pool.back(); pool.pop_back(); return e;
+    }
+    ~ggml_cuda_optime() { report(); }
+    void report() {
+        if (lvl() <= 0 || n_graphs == 0) return;
+        std::vector<std::pair<std::string, ggml_cuda_optime_acc>> v(acc.begin(), acc.end());
+        std::sort(v.begin(), v.end(), [](const auto & a, const auto & b) { return a.second.ms > b.second.ms; });
+        fprintf(stderr, "\n=== GGML_CUDA_OP_TIMING: %ld graphs, %.3f ms total GPU time, %.3f ms/graph ===\n", n_graphs, total_ms, total_ms / n_graphs);
+        fprintf(stderr, "%10s %8s %9s %8s  %s\n", "ms/graph", "units/g", "us/unit", "pct", "unit");
+        for (const auto & [k, a] : v) {
+            fprintf(stderr, "%10.4f %8.1f %9.2f %7.2f%%  %s\n", a.ms / n_graphs, (double) a.n / n_graphs, 1e3 * a.ms / a.n, 100.0 * a.ms / total_ms, k.c_str());
+        }
+    }
+};
+static ggml_cuda_optime & ggml_cuda_optime_get() { static ggml_cuda_optime t; return t; }
+
+static std::string ggml_cuda_optime_key(const ggml_cgraph * cgraph, int i, int span) {
+    const ggml_tensor * node = cgraph->nodes[i];
+    char buf[512];
+    std::string name = node->name;
+    // strip the layer suffix ("-12") and trailing view markers to merge layers
+    while (!name.empty() && (isdigit((unsigned char) name.back()) || name.back() == '-')) name.pop_back();
+    if (name.size() > 24) name.resize(24);
+    int n = snprintf(buf, sizeof(buf), "%s", ggml_op_desc(node));
+    if (span > 1) {
+        // name the fused group by its ops
+        std::string ops;
+        for (int k = i; k < i + span && k < cgraph->n_nodes; ++k) {
+            const ggml_tensor * t = cgraph->nodes[k];
+            if (ggml_cuda_is_view_or_noop(t)) continue;
+            if (!ops.empty()) ops += '+';
+            ops += ggml_op_desc(t);
+        }
+        n = snprintf(buf, sizeof(buf), "[%s]", ops.c_str());
+    }
+    if (node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID) {
+        const ggml_tensor * w = node->src[0];
+        n += snprintf(buf + n, sizeof(buf) - n, " %s %lldx%lld x%lld", ggml_type_name(w->type), (long long) w->ne[0], (long long) w->ne[1], (long long) node->ne[1]);
+        if (node->op == GGML_OP_MUL_MAT && ggml_get_op_params_i32(node, 1) == GGML_HINT_SRC0_IS_HADAMARD) n += snprintf(buf + n, sizeof(buf) - n, " HAD");
+    } else {
+        n += snprintf(buf + n, sizeof(buf) - n, " %lldx%lldx%lld", (long long) node->ne[0], (long long) node->ne[1], (long long) node->ne[2]);
+    }
+    snprintf(buf + n, sizeof(buf) - n, " %s", name.c_str());
+    return buf;
+}
