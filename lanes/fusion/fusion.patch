+#pragma once
+// sm_61 one-column BF16 mat-vec (fusion tree). The generic mul_mat_vec_f runs one block per row with 4-byte weight loads
+// and re-reads the whole F32 activation per block (Bonsai 2 ssm_alpha/ssm_beta: 96 blocks x 20 KB = 1.9 MB of y traffic
+// against 0.96 MB of weights, 4.7x off bandwidth). Here a block stages y once in shared memory and runs one warp per row
+// with 16-byte weight loads; bf16 -> f32 is a 16-bit shift, accumulation is f32 FMA per lane then a warp reduce.
+// Opt-in: GGML_CUDA_BF16_MV_P61=1 enables it (untested on the card at patch time); default is the generic kernel.
+#include "common.cuh"
+
+#define MMVF_BF16_P61_NWARPS 4
+
+static __global__ void __launch_bounds__(MMVF_BF16_P61_NWARPS * 32) mul_mat_vec_bf16_p61(
+        const nv_bfloat16 * GGML_CUDA_RESTRICT x, const float * GGML_CUDA_RESTRICT y, float * GGML_CUDA_RESTRICT dst,
+        const int ncols, const int nrows, const int stride_row, const int64_t stride_channel_x, const int64_t stride_channel_dst) {
+    extern __shared__ float4 s_y4[];
+    const int channel = blockIdx.y;
+    x   += channel * stride_channel_x;
+    dst += channel * stride_channel_dst;
+    const int tid  = threadIdx.x;
+    const int lane = tid % WARP_SIZE;
+    const int warp = tid / WARP_SIZE;
+    const int n4   = ncols / 4;
+    for (int i = tid; i < n4; i += MMVF_BF16_P61_NWARPS * WARP_SIZE) {
+        s_y4[i] = ((const float4 *) y)[i];
+    }
+    __syncthreads();
+    const int row = blockIdx.x * MMVF_BF16_P61_NWARPS + warp;
+    if (row >= nrows) {
+        return;
+    }
+    const uint4 * xr  = (const uint4 *) (x + (int64_t) row * stride_row);
+    const int     n16 = ncols / 8;
+    float acc = 0.0f;
+#pragma unroll 4
+    for (int c = lane; c < n16; c += WARP_SIZE) {
+        const uint4  v  = xr[c];
+        const float4 ya = s_y4[2*c];
+        const float4 yb = s_y4[2*c + 1];
+        acc = fmaf(__uint_as_float(v.x << 16), ya.x, acc); acc = fmaf(__uint_as_float(v.x & 0xffff0000u), ya.y, acc);
+        acc = fmaf(__uint_as_float(v.y << 16), ya.z, acc); acc = fmaf(__uint_as_float(v.y & 0xffff0000u), ya.w, acc);
+        acc = fmaf(__uint_as_float(v.z << 16), yb.x, acc); acc = fmaf(__uint_as_float(v.z & 0xffff0000u), yb.y, acc);
+        acc = fmaf(__uint_as_float(v.w << 16), yb.z, acc); acc = fmaf(__uint_as_float(v.w & 0xffff0000u), yb.w, acc);
+    }
+    acc = warp_reduce_sum(acc);
+    if (lane == 0) {
+        dst[row] = acc;
+    }
+}
+
+// plain 2D (or channel-strided pair) one-column bf16 mat-vec on sm_61; false when not applicable (caller falls back)
+static bool mul_mat_vec_bf16_p61_try(
+        const nv_bfloat16 * x, const float * y, float * dst, const int64_t ncols, const int64_t nrows, const int64_t stride_row,
+        const int64_t nchannels, const int64_t stride_channel_x, const int64_t stride_channel_dst, cudaStream_t stream) {
+    // opt-in until measured on the card: GGML_CUDA_BF16_MV_P61=1 enables
+    static const bool enabled = getenv("GGML_CUDA_BF16_MV_P61") != nullptr && atoi(getenv("GGML_CUDA_BF16_MV_P61")) != 0;
+    if (!enabled || ggml_cuda_info().devices[ggml_cuda_get_device()].cc != GGML_CUDA_CC_DP4A) {
+        return false;
+    }
+    const size_t smem = (size_t) ncols * sizeof(float);
+    if (ncols % 8 != 0 || ncols > INT_MAX || nrows > INT_MAX || stride_row > INT_MAX || smem > 48u * 1024u ||
+            (stride_row * (int64_t) sizeof(nv_bfloat16)) % 16 != 0 || (stride_channel_x * (int64_t) sizeof(nv_bfloat16)) % 16 != 0 ||
+            ((uintptr_t) x) % 16 != 0 || ((uintptr_t) y) % 16 != 0 || nchannels < 1 || nchannels > 65535) {
+        return false;
+    }
+    const dim3 grid((unsigned) ((nrows + MMVF_BF16_P61_NWARPS - 1) / MMVF_BF16_P61_NWARPS), (unsigned) nchannels, 1);
+    mul_mat_vec_bf16_p61<<<grid, MMVF_BF16_P61_NWARPS * WARP_SIZE, smem, stream>>>(
+        x, y, dst, (int) ncols, (int) nrows, (int) stride_row, stride_channel_x, stride_channel_dst);
+    return true;
