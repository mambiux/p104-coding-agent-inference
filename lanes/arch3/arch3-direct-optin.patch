+static int ggml_cuda_ptq1_0_p61_dir_env(const char * name, const int def) {
+    const char * s = getenv(name);
+    return s == nullptr ? def : atoi(s);
+}
+
+template <int R, int NW, int PF>
+static void mul_mat_vec_ptq1_0_p61_dir_launch(
+        const void * vx, const void * vy, const ggml_cuda_mm_fusion_args_device & fusion, float * dst,
+        const int nblk, const int nrows_x, const int stride_row_x, cudaStream_t stream) {
+    const bool has_gate = fusion.gate != nullptr;
+    const float * x_bias    = (const float *) fusion.x_bias;
+    const float * gate_bias = has_gate ? (const float *) fusion.gate_bias : nullptr;
+    const dim3 grid((nrows_x + 4 * R * NW - 1) / (4 * R * NW));
+    if (has_gate) {
+        mul_mat_vec_ptq1_0_p61_dir<R, NW, PF, true><<<grid, NW * WARP_SIZE, 0, stream>>>(
+            vx, fusion.gate, (const int *) vy, x_bias, gate_bias, fusion.glu_op, fusion.glu_limit, dst, nblk, nrows_x, stride_row_x);
+    } else {
+        mul_mat_vec_ptq1_0_p61_dir<R, NW, PF, false><<<grid, NW * WARP_SIZE, 0, stream>>>(
+            vx, nullptr, (const int *) vy, x_bias, nullptr, fusion.glu_op, fusion.glu_limit, dst, nblk, nrows_x, stride_row_x);
+    }
+}
