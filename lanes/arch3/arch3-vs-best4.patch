+template <int NC, int RB, bool has_gate>
+__launch_bounds__(256, 1)
+static __global__ void mul_mat_vec_ptq1_0_p61_as(
+        const void * __restrict__ vx, const void * __restrict__ vgate, const char * __restrict__ y,
+        const float * __restrict__ x_bias, const float * __restrict__ gate_bias, const ggml_glu_op glu_op, const float glu_limit,
+        float * __restrict__ dst, const int nblk, const int nrows, const int stride_row_x,
+        const int nblk_pt, const int stride_col_y_bytes, const int stride_col_dst, const int G) {
+    constexpr int NM = has_gate ? 2 : 1;
+    extern __shared__ float as_part[]; // [G][RB][NM][NC][nblk]
+    const int tid = threadIdx.x;
+    const int g   = tid / nblk;
+    const int kb  = tid - g * nblk;
+    const bool active = g < G;
+
+    int   u[NC][32];
+    float d8[NC][4];
+    int   is[NC][4];
+    if (active) {
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            const int4 * yc = (const int4 *) (y + (size_t) c * stride_col_y_bytes) + kb;
+#pragma unroll
+            for (int t = 0; t < 8; ++t) {
+                const int4 q = __ldg(yc + t * nblk_pt);
+                u[c][4 * t + 0] = q.x;
+                u[c][4 * t + 1] = q.y;
+                u[c][4 * t + 2] = q.z;
+                u[c][4 * t + 3] = q.w;
+            }
+            const int4 dsq    = __ldg(yc + 8 * nblk_pt);
+            const int  dsw[4] = { dsq.x, dsq.y, dsq.z, dsq.w };
+#pragma unroll
+            for (int k = 0; k < 4; ++k) {
+                const half2 ds = *reinterpret_cast<const half2 *>(&dsw[k]);
+                d8[c][k] = __low2float(ds);
+                is[c][k] = (int) __half_as_short(__high2half(ds));
+            }
+        }
+    }
+
+    const uint32_t * __restrict__ X  = (const uint32_t *) vx;
+    const uint32_t * __restrict__ GT = (const uint32_t *) vgate;
+    float * part = as_part + (size_t) g * RB * NM * NC * nblk;
+    const int rows_per_batch = G * RB;
+    const int nbatches       = (nrows + rows_per_batch - 1) / rows_per_batch;
