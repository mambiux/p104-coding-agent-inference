+// Half-block form of the activation-stationary kernel: thread pair (kb, h) splits K-block kb. Half h owns qs bytes
+// 8h..8h+7 (elements 16t + 8h + 0..7), qs bytes 16+4h..19+4h (elements 80 + 8t + 4h + 0..3) and qh byte h
+// (elements 120 + 2t + h), i.e. exactly 64 elements = 16 activation words per column, so the activations of 4
+// columns take 64 registers instead of 128 and two CTAs fit per SM.
+template <int NC>
+static __device__ __forceinline__ void ptq1_p61_ash_block(const uint32_t (&w)[4], const int h, const int (&hu)[NC][16],
+                                                          const float (&d8)[NC][4], const int (&is)[NC][4], float (&out)[NC]) {
+    int sumi[NC][4];
+#pragma unroll
+    for (int c = 0; c < NC; ++c) {
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            sumi[c][k] = h == 0 ? -is[c][k] : 0; // the exact int sum (digit bias) is folded in once per block
+        }
+    }
+    // words 0, 1 of this half (qs bytes 8h .. 8h+7): element 16t + 4(2h+j) + i -> hu[2t + j], sub-block t/2
+#pragma unroll
+    for (int j = 0; j < 2; ++j) {
+        uint32_t v_lo = w[j] & 0x00FF00FFu;
+        uint32_t v_hi = __byte_perm(w[j], 0, 0x4341);
+#pragma unroll
+        for (int t = 0; t < 5; ++t) {
+            const uint32_t w_lo = ptq1_p61_mul3(v_lo);
+            const uint32_t w_hi = ptq1_p61_mul3(v_hi);
+            v_lo = w_lo & 0x00FF00FFu;
+            v_hi = w_hi & 0x00FF00FFu;
+            const int q = (int) __byte_perm(w_lo, w_hi, 0x7351);
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+                sumi[c][t >> 1] = ggml_cuda_dp4a(q, hu[c][2 * t + j], sumi[c][t >> 1]);
+            }
+        }
+    }
+    // word 2 (qs bytes 16+4h .. 19+4h): element 80 + 8t + 4h + i -> hu[10 + t], sub-block (80 + 8t) / 32
+    {
+        uint32_t v_lo = w[2] & 0x00FF00FFu;
+        uint32_t v_hi = __byte_perm(w[2], 0, 0x4341);
+#pragma unroll
+        for (int t = 0; t < 5; ++t) {
+            const uint32_t w_lo = ptq1_p61_mul3(v_lo);
+            const uint32_t w_hi = ptq1_p61_mul3(v_hi);
+            v_lo = w_lo & 0x00FF00FFu;
+            v_hi = w_hi & 0x00FF00FFu;
+            const int q = (int) __byte_perm(w_lo, w_hi, 0x7351);
+            const int k = (80 + 8 * t) >> 5;
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+                sumi[c][k] = ggml_cuda_dp4a(q, hu[c][10 + t], sumi[c][k]);
+            }
+        }
+    }
+    // qh byte h: 4 trits, elements 120 + 2t + h. H_t = floor(v 3^t / 256) in 16-bit lanes, digit_t = H_{t+1} - 3 H_t
+    {
+        const uint32_t v  = (w[3] >> (8 * h)) & 0xFFu;
+        const uint32_t p1 = ptq1_p61_mul3(v);
+        const uint32_t p2 = ptq1_p61_mul3(p1);
+        const uint32_t p3 = ptq1_p61_mul3(p2);
+        const uint32_t p4 = ptq1_p61_mul3(p3);
+        const uint32_t lo = p1 | (p2 << 16);
+        const uint32_t hi = p3 | (p4 << 16);
+        const uint32_t Hn = __byte_perm(lo, hi, 0x7531);  // [H1, H2, H3, H4]
+        const uint32_t Hp = Hn << 8;                      // [0, H1, H2, H3]
+        const int      q  = (int) (Hn - ptq1_p61_mul3(Hp)); // bytewise digits, no borrow (each byte >= 0, 3 H <= 78)
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            sumi[c][3] = ggml_cuda_dp4a(q, hu[c][15], sumi[c][3]);
+        }
+    }
+    const float d = __half2float(__ushort_as_half((unsigned short) (w[3] >> 16)));
+#pragma unroll
+    for (int c = 0; c < NC; ++c) {
+        float a = 0.0f;
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            a = fmaf(d8[c][k], ptq1_p61_i2f(sumi[c][k]), a);
+        }
+        out[c] = d * a;
+    }
+}
