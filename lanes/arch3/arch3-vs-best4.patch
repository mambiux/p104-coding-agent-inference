+                const size_t off = ((size_t) row * stride_row_x + kb) * 7;
+#pragma unroll
+                for (int i = 0; i < 7; ++i) {
+                    w[0][i] = __ldg(X + off + i);
+                    if constexpr (has_gate) {
+                        w[NM - 1][i] = __ldg(GT + off + i);
+                    }
+                }
+            };
+            load(wc, 0);
+#pragma unroll
+            for (int rr = 0; rr < RB; ++rr) {
+                uint32_t wn[NM][7];
+                if (rr + 1 < RB) {
