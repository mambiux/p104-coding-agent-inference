+template <int NC, int RB, bool has_gate>
+static void mul_mat_vec_ptq1_0_p61_as_launch(
+        const void * vx, const char * y, const ggml_cuda_mm_fusion_args_device & fusion, float * dst,
+        const int nblk, const int nrows_x, const int stride_row_x, const int nblk_pt, const int stride_col_y_bytes,
+        const int stride_col_dst, cudaStream_t stream) {
+    constexpr int NM = has_gate ? 2 : 1;
+    static const int tpc_env = ggml_cuda_ptq1_0_p61_mc_env("GGML_CUDA_PTQ1_P61_AS_THREADS", 160);
+    const int G       = std::max(1, std::min(256, tpc_env) / nblk);
+    const int threads = ((G * nblk + 31) / 32) * 32;
+    const size_t smem = (size_t) G * RB * NM * NC * nblk * sizeof(float);
+    const int nbatches = (nrows_x + G * RB - 1) / (G * RB);
+    static const int cps_env = ggml_cuda_ptq1_0_p61_mc_env("GGML_CUDA_PTQ1_P61_AS_CTAS", 0);
+    const int nsm  = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+    int cps = cps_env;
+    if (cps <= 0) {
+        // occupancy depends on (threads, smem), i.e. on nblk: cache the few distinct K of a model (host-side cost per call)
+        static int cache_nblk[8] = { 0 }, cache_cps[8] = { 0 };
+        for (int i = 0; i < 8; ++i) {
+            if (cache_nblk[i] == nblk) { cps = cache_cps[i]; break; }
+        }
+        if (cps <= 0) {
+            CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&cps, mul_mat_vec_ptq1_0_p61_as<NC, RB, has_gate>, threads, smem));
+            cps = std::max(cps, 1);
+            for (int i = 0; i < 8; ++i) {
+                if (cache_nblk[i] == 0) { cache_nblk[i] = nblk; cache_cps[i] = cps; break; }
+            }
+        }
+    }
+    const int grid = std::min(nbatches, nsm * cps);
+    mul_mat_vec_ptq1_0_p61_as<NC, RB, has_gate><<<grid, threads, smem, stream>>>(
+        vx, has_gate ? fusion.gate : nullptr, y, (const float *) fusion.x_bias, has_gate ? (const float *) fusion.gate_bias : nullptr,
+        fusion.glu_op, fusion.glu_limit, dst, nblk, nrows_x, stride_row_x, nblk_pt, stride_col_y_bytes, stride_col_dst, G);
+}
+
+template <int NC>
+static void mul_mat_vec_ptq1_0_p61_as_launch_nc(
+        const void * vx, const char * y, const ggml_cuda_mm_fusion_args_device & fusion, float * dst,
+        const int nblk, const int nrows_x, const int stride_row_x, const int nblk_pt, const int stride_col_y_bytes,
+        const int stride_col_dst, cudaStream_t stream) {
+    static const int rb    = ggml_cuda_ptq1_0_p61_mc_env("GGML_CUDA_PTQ1_P61_AS_RB", 8);
+    static const int split = ggml_cuda_ptq1_0_p61_mc_env("GGML_CUDA_PTQ1_P61_AS_SPLIT", 2); // 2 = half-block threads, 1 = full block
+    if (split == 2) {
+#define P61_ASH_L(RB) do { if (fusion.gate != nullptr) { mul_mat_vec_ptq1_0_p61_ash_launch<NC, RB, true>(vx, y, fusion, dst, nblk, nrows_x, stride_row_x, nblk_pt, stride_col_y_bytes, stride_col_dst, stream); } \
+                           else { mul_mat_vec_ptq1_0_p61_ash_launch<NC, RB, false>(vx, y, fusion, dst, nblk, nrows_x, stride_row_x, nblk_pt, stride_col_y_bytes, stride_col_dst, stream); } } while (0)
+        switch (rb) {
+            case 4:  P61_ASH_L(4);  break;
+            default: P61_ASH_L(8);  break;
+        }
+#undef P61_ASH_L
+        return;
+    }
+#define P61_AS_L(RB) do { if (fusion.gate != nullptr) { mul_mat_vec_ptq1_0_p61_as_launch<NC, RB, true>(vx, y, fusion, dst, nblk, nrows_x, stride_row_x, nblk_pt, stride_col_y_bytes, stride_col_dst, stream); } \
+                          else { mul_mat_vec_ptq1_0_p61_as_launch<NC, RB, false>(vx, y, fusion, dst, nblk, nrows_x, stride_row_x, nblk_pt, stride_col_y_bytes, stride_col_dst, stream); } } while (0)
+    switch (rb) {
+        case 4:  P61_AS_L(4);  break;
+        default: P61_AS_L(8);  break;
+    }
+#undef P61_AS_L
+}
