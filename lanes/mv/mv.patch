+// Geometry selection. Defaults below; override with GGML_CUDA_PTQ1_P61_CFG="R,NW,persist,S[;R,NW,persist,S[;...]]":
+// first quad = big single-matrix shapes, second = small ones (weights below GGML_CUDA_PTQ1_P61_SMALL bytes, default 8 MB),
+// third = gate+up fused, fourth = long-K shapes (nsteps >= GGML_CUDA_PTQ1_P61_LONGK, default 16; takes precedence over
+// big/small). persist = 0: one row group per warp (grid = ngroups / NW); k > 0: grid = k * resident CTAs.
+struct ptq1_p61_cfg {
+    int R, NW, persist, S;
+};
+struct ptq1_p61_cfgs {
+    ptq1_p61_cfg big, small, gate, longk;
+    size_t       small_bytes;
+    int          longk_steps;
+};
+static const ptq1_p61_cfgs & ggml_cuda_ptq1_0_p61_cfg() {
+    static const ptq1_p61_cfgs cfgs = [] {
+        ptq1_p61_cfgs c;
+        c.big   = { PTQ1_P61_R, PTQ1_P61_NW, PTQ1_P61_PERSIST, PTQ1_P61_S };
+        c.small = c.big;
+        c.gate  = c.big;
+        c.longk = { PTQ1_P61_R, PTQ1_P61_NW, PTQ1_P61_PERSIST, PTQ1_P61_S_LONGK };
+        c.small_bytes = 8u << 20;
+        c.longk_steps = 16;
+        if (const char * s = getenv("GGML_CUDA_PTQ1_P61_CFG")) {
+            ptq1_p61_cfg * slots[4] = { &c.big, &c.small, &c.gate, &c.longk };
+            int n = 0;
+            while (s && *s && n < 4) {
+                ptq1_p61_cfg v = { 2, 4, 0, 1 };
+                if (sscanf(s, "%d,%d,%d,%d", &v.R, &v.NW, &v.persist, &v.S) < 3) {
+                    break;
+                }
+                *slots[n] = v;
+                if (n == 0) { c.small = v; c.gate = v; c.longk = v; }
+                ++n;
+                s = strchr(s, ';');
+                if (s) { ++s; }
+            }
+        }
+        if (const char * s = getenv("GGML_CUDA_PTQ1_P61_SMALL")) {
+            c.small_bytes = (size_t) atoll(s);
+        }
+        if (const char * s = getenv("GGML_CUDA_PTQ1_P61_LONGK")) {
+            c.longk_steps = atoi(s);
+        }
+        return c;
+    }();
+    return cfgs;
+}
