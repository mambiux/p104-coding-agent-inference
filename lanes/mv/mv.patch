+template <int R, int NW, int S, bool has_gate>
+static void mul_mat_vec_ptq1_0_p61_launch(
+        const void * vx, const void * vgate, const int * y, const float * x_bias, const float * gate_bias,
+        const ggml_glu_op glu_op, const float glu_limit, float * dst, const int nblk, const int nrows, const int stride_row_x,
+        const int persist, cudaStream_t stream) {
+    static int resident = -1;   // resident CTAs on the whole device for this instantiation (persist mode)
+    if (resident < 0) {
+        int per_sm = 0;
+        CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per_sm, mul_mat_vec_ptq1_0_p61<R, NW, S, has_gate>, NW * WARP_SIZE, 0));
+        resident = std::max(1, per_sm) * ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+    }
+    constexpr int RPW = (4 / S) * R;
+    const int ngroups = (nrows + RPW - 1) / RPW;
+    int grid = (ngroups + NW - 1) / NW;
+    if (persist > 0) {
+        grid = std::min(grid, persist * resident);
+    }
+    mul_mat_vec_ptq1_0_p61<R, NW, S, has_gate><<<grid, NW * WARP_SIZE, 0, stream>>>(
+        vx, vgate, y, x_bias, gate_bias, glu_op, glu_limit, dst, nblk, nrows, stride_row_x);
+}
