+// Fold the P partials of one chunk into the running accumulator (acc = dst rows, accm = (max, sum) per row).
+static __global__ void k_fattn_chunk_merge(const float * __restrict__ parts, const float2 * __restrict__ meta,
+        float * __restrict__ acc, float2 * __restrict__ accm, const int P, const int D, const bool first, const bool last) {
+    const int64_t j = blockIdx.x;
+    const float2 * mj = meta + j*P;
+
+    float m = first ? -FLT_MAX/2.0f : accm[j].x;
+    for (int l = 0; l < P; ++l) {
+        m = fmaxf(m, mj[l].x);
+    }
+    const float2 am = first ? make_float2(-FLT_MAX/2.0f, 0.0f) : accm[j];
+    const float  sa = first ? 0.0f : expf(am.x - m);
+
+    float den = am.y*sa;
+    for (int l = 0; l < P; ++l) {
+        den += expf(mj[l].x - m)*mj[l].y;
+    }
+    for (int i = threadIdx.x; i < D; i += blockDim.x) {
+        float num = first ? 0.0f : acc[j*D + i]*sa;
+        for (int l = 0; l < P; ++l) {
+            num += expf(mj[l].x - m)*parts[(j*P + l)*D + i];
+        }
+        acc[j*D + i] = last ? num/den : num;
+    }
+    __syncthreads(); // all threads have read accm[j]
+    if (!last && threadIdx.x == 0) {
+        accm[j] = make_float2(m, den);
+    }
+}
