+// ---------------- KV-chunked prefill on the tile path ----------------
+// The tile kernel needs f16 K/V; for quantized caches launch_fattn converts the whole K/V view into scratch reserved
+// behind dst (n_kv x n_head_kv x D x 2 B for each of K and V: 256 MiB at 64k ctx for Bonsai 27B). With chunking, the
+// KV sequence is processed in chunks of GGML_CUDA_FA_CHUNK tokens (default 16384, 0 = off): each chunk is converted into
+// a chunk-sized scratch, the tile kernel writes unnormalized partials + (max, sum) per parallel block, and a merge
+// kernel folds them into a running (dst, max, sum) accumulator. Exact up to fp32 rounding; same f16 data as before.
+static int64_t ggml_cuda_fattn_chunk_size() {
+    static const int64_t c = [] {
+        const char * e = getenv("GGML_CUDA_FA_CHUNK");
+        const int64_t v = e ? atoll(e) : 16384;
+        return v <= 0 ? (int64_t) 0 : GGML_PAD(v, (int64_t) FATTN_KQ_STRIDE);
+    }();
+    return c;
+}
+
+struct ggml_cuda_fattn_chunk_layout {
+    uintptr_t K, V, parts, meta, accm, end;
+    int64_t   chunk;
+    int       P;
+};
+
+static bool ggml_cuda_fattn_chunk_applies(const int device, const ggml_tensor * dst) {
+    const int64_t chunk = ggml_cuda_fattn_chunk_size();
+    if (chunk == 0) {
+        return false;
+    }
+    const ggml_tensor * K     = dst->src[1];
+    const ggml_tensor * V     = dst->src[2];
+    const ggml_tensor * sinks = dst->src[4];
+    if (K->ne[1] <= chunk || sinks || ggml_cuda_fattn_prefill_f16(dst)) {
+        return false;
+    }
+    if (!ggml_is_quantized(K->type) || !ggml_is_quantized(V->type)) {
+        return false;
+    }
+    const bool V_is_K_view = V->view_src && (V->view_src == K || (V->view_src == K->view_src && V->view_offs == K->view_offs));
+    if (V_is_K_view || K->ne[1] != V->ne[1] || K->nb[0] != ggml_type_size(K->type) || V->nb[0] != ggml_type_size(V->type)) {
+        return false;
+    }
+    if (ggml_cuda_get_best_fattn_kernel(device, dst) != BEST_FATTN_KERNEL_TILE) {
+        return false;
+    }
+    if (ggml_cuda_fattn_pad72_applies_fwd(device, dst)) {
+        return false;
+    }
+    if (ggml_cuda_flash_attn_ext_vec_p61_applies(ggml_cuda_info().devices[device].cc, dst)) {
+        return false; // the p61 decode kernel handles it in place
+    }
+    return true;
+}
+
+// Must match the scratch placement of ggml_cuda_flash_attn_ext_get_f16_extra_data for every chunk (K first, then V,
+// each 128-aligned, starting right after dst); the partial/meta/accumulator buffers follow the full-chunk V scratch.
+static ggml_cuda_fattn_chunk_layout ggml_cuda_fattn_chunk_get_layout(const ggml_tensor * dst) {
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+    ggml_cuda_fattn_chunk_layout L = {};
+    L.chunk = ggml_cuda_fattn_chunk_size();
+    const int64_t nel  = ggml_nelements(dst);
+    const int64_t nrow = ggml_nrows(dst);
+    // number of parallel blocks: >= 2, bounded by a 16 MiB budget for the partials
+    L.P = (int) std::max<int64_t>(2, std::min<int64_t>(32, (int64_t(16) << 20) / (nel*int64_t(sizeof(float)))));
+
+    uintptr_t end = (uintptr_t) dst->data + ggml_nbytes(dst);
+    end = GGML_PAD(end, 128); L.K = end; end += size_t(K->ne[0])*L.chunk*K->ne[2]*K->ne[3]*sizeof(half);
+    end = GGML_PAD(end, 128); L.V = end; end += size_t(V->ne[0])*L.chunk*V->ne[2]*V->ne[3]*sizeof(half);
+    end = GGML_PAD(end, 128); L.parts = end; end += size_t(L.P)*nel*sizeof(float);
+    end = GGML_PAD(end, 128); L.meta  = end; end += size_t(L.P)*nrow*sizeof(float2);
+    end = GGML_PAD(end, 128); L.accm  = end; end += size_t(nrow)*sizeof(float2);
+    L.end = end;
+    return L;
+}
