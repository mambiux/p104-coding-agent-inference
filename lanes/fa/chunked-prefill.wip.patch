+static void ggml_cuda_flash_attn_ext_chunked(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * V    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    cudaStream_t stream = ctx.stream();
+
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && ggml_is_contiguous(dst));
+    const ggml_cuda_fattn_chunk_layout L = ggml_cuda_fattn_chunk_get_layout(dst);
+    const int64_t n_kv   = K->ne[1];
+    const int64_t nrow   = ggml_nrows(dst);
+    const int     D      = dst->ne[0];
+    const int     nchunk = (int) ((n_kv + L.chunk - 1) / L.chunk);
+
+    ggml_cuda_fattn_chunk_out out = { (float *) L.parts, (float2 *) L.meta, L.P };
+
+    for (int c = 0; c < nchunk; ++c) {
+        const int64_t c0  = int64_t(c)*L.chunk;
+        const int64_t len = std::min(L.chunk, n_kv - c0);
+
+        ggml_tensor Kc = *K;
+        Kc.ne[1] = len; Kc.data = (char *) K->data + c0*K->nb[1]; Kc.view_offs = K->view_offs + c0*K->nb[1];
+        ggml_tensor Vc = *V;
+        Vc.ne[1] = len; Vc.data = (char *) V->data + c0*V->nb[1]; Vc.view_offs = V->view_offs + c0*V->nb[1];
+        ggml_tensor Mc;
+        if (mask) {
+            Mc = *mask;
+            Mc.ne[0] = len; Mc.data = (char *) mask->data + c0*mask->nb[0]; Mc.view_offs = mask->view_offs + c0*mask->nb[0];
+        }
+        ggml_tensor Oc = *dst;
+        Oc.src[1] = &Kc;
+        Oc.src[2] = &Vc;
+        Oc.src[3] = mask ? &Mc : nullptr;
+
+        ggml_cuda_fattn_chunk_out_ptr = &out;
+        ggml_cuda_flash_attn_ext_tile(ctx, &Oc);
+        ggml_cuda_fattn_chunk_out_ptr = nullptr;
+
+        // the f16 scratch of this chunk must lie inside the reservation
+        GGML_ASSERT(ggml_cuda_flash_attn_ext_get_f16_extra_data(&Oc, true, true).end <= L.parts);
+
+        k_fattn_chunk_merge<<<nrow, std::min(D, 256), 0, stream>>>(
+            (const float *) L.parts, (const float2 *) L.meta, (float *) dst->data, (float2 *) L.accm, L.P, D, c == 0, c == nchunk - 1);
+        CUDA_CHECK(cudaGetLastError());
+    }
+}
